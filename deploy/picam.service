[Unit]
Description=PiCam PTZ Camera Controller
After=network-online.target

[Service]
WorkingDirectory=%h/apps/picam
EnvironmentFile=%h/apps/picam.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node dist/main.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
