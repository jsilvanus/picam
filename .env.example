# Server configuration
PICAM_PORT=3300
PICAM_HOST=0.0.0.0
PICAM_MODE=simulation # simulation | production

# Near focus limit in metres (default: 5.0)
PICAM_NEAR_LIMIT_M=5.0

# Camera 1 (AVer PTZ330 or compatible)
PICAM_CAM1_NAME="Camera 1"
PICAM_CAM1_HOST=192.168.1.101
PICAM_CAM1_VISCA_PORT=52381
PICAM_CAM1_CGI_PORT=80
PICAM_CAM1_CGI_USER=admin
PICAM_CAM1_CGI_PASSWORD=admin

# Camera 2 (AVer PTZ330 or compatible)
PICAM_CAM2_NAME="Camera 2"
PICAM_CAM2_HOST=192.168.1.102
PICAM_CAM2_VISCA_PORT=52381
PICAM_CAM2_CGI_PORT=80
PICAM_CAM2_CGI_USER=admin
PICAM_CAM2_CGI_PASSWORD=admin

# Optional MediaMTX base URLs for stream URLs
PICAM_MEDIAMTX_RTSP_BASE_URL=rtsp://127.0.0.1:8554
PICAM_MEDIAMTX_RTMP_BASE_URL=rtmp://127.0.0.1:1935
